# Optional API-assisted proposal smoke.
# Copy this file to `.env` for local runs.
# Do not commit real keys.

# OpenAI-compatible provider.
SELECTION_API_KEY=
SELECTION_API_ENDPOINT=
SELECTION_API_MODEL=

# Optional fallback for the default OpenAI Chat Completions endpoint.
OPENAI_API_KEY=

# Cross-provider iterative proposer benchmark.
# Set both key and model for each provider you want to include.
OPENAI_MODEL=
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=
